{
  "name": "VerityAI-desktop",
  "productName": "VerityAI",
  "version": "1.0.0",
  "description": "Local-first AI study and note-taking workspace for Windows.",
  "private": true,
  "main": "main.js",
  "author": {
    "name": "VerityAI Project",
    "email": "support@VerityAI.example"
  },
  "license": "SEE LICENSE IN ../LICENSE.md",
  "scripts": {
    "build:renderer": "node scripts/build-renderer.mjs",
    "start": "electron .",
    "dist": "npm run build:renderer && electron-builder --win nsis --x64",
    "dist:exe": "npm run build:renderer && electron-builder --win nsis --x64",
    "dist:all": "npm run build:renderer && electron-builder --win nsis appx --x64",
    "dist:msix": "npm run build:renderer && electron-builder --win appx --x64"
  },
  "devDependencies": {
    "electron": "^35.0.0",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "com.VerityAI.desktop",
    "productName": "VerityAI",
    "copyright": "Copyright © 2026 VerityAI Project",
    "asar": true,
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "build/icon.png"
    ],
    "extraResources": [
      {
        "from": "../.next/standalone",
        "to": "app",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "../.next/standalone/node_modules",
        "to": "app/node_modules"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false,
      "license": "../LICENSE.md",
      "shortcutName": "VerityAI"
    },
    "appx": {
      "identityName": "VerityAI.Desktop",
      "publisher": "CN=VerityAI Project",
      "publisherDisplayName": "VerityAI Project",
      "applicationId": "VerityAI",
      "displayName": "VerityAI",
      "backgroundColor": "#141218",
      "languages": [
        "en-US"
      ]
    }
  }
}