# VerityAI Environment Configuration Template
# Copy this file to .env or .env.local to configure your environment.

# ==============================================================================
# Database & Storage Configuration
# ==============================================================================
# Option 1 (Default - Local / Embedded Mode):
# Uses embedded PGlite database stored in the specified directory.
# Migrations from NITRO_MIGRATIONS_DIR are applied automatically on startup.
NITRO_DATA_DIR='./data'
NITRO_MIGRATIONS_DIR='./drizzle'

# Option 2 (Server Mode):
# To use an external PostgreSQL server, comment out NITRO_DATA_DIR above and uncomment DATABASE_URL below.
# The app migrates a server database automatically on startup — no manual push needed.
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/VerityAI"

# ==============================================================================
# Runtime Mode (advanced)
# ==============================================================================
# NITRO_DESKTOP=1 when running inside the Electron shell (set by desktop/main.js).
# NITRO_DESKTOP_BUILD=1 only while building the desktop renderer (standalone output).
# NEXT_TELEMETRY_DISABLED=1 opts out of anonymous Next.js build telemetry.
# NITRO_DESKTOP=""
# NITRO_DESKTOP_BUILD=""
# NEXT_TELEMETRY_DISABLED=1

# ==============================================================================
# AI & Security Configuration
# ==============================================================================
# Local AI context window size in tokens (minimum 4096, default 8192)
NITRO_LOCAL_CONTEXT=8192

# Optional 32-byte encryption key secret for API keys stored at rest.
# If unset, an encryption key is automatically generated in $NITRO_DATA_DIR/local.key
# NITRO_KEY_SECRET=""

# ==============================================================================
# Publisher & Application Metadata (About and Legal pages)
# ==============================================================================
NEXT_PUBLIC_PUBLISHER_NAME="VerityAI"
NEXT_PUBLIC_PUBLISHER_ENTITY="VerityAI Project"
NEXT_PUBLIC_PUBLISHER_ADDRESS="Local Developer Environment"
NEXT_PUBLIC_SUPPORT_EMAIL="support@VerityAI.example"
NEXT_PUBLIC_PRIVACY_EMAIL="privacy@VerityAI.example"
NEXT_PUBLIC_PUBLISHER_WEBSITE="https://VerityAI.local"
