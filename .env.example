# VerityAI Environment Configuration Template
# Copy this file to .env or .env.local to configure your environment.

# ==============================================================================
# Database & Storage Configuration
# ==============================================================================
# Option 1 (Default - Local / Embedded Mode):
# Uses embedded PGlite database stored in the specified directory.
# Migrations from VERITY_MIGRATIONS_DIR are applied automatically on startup.
VERITY_DATA_DIR='./data'
VERITY_MIGRATIONS_DIR='./drizzle'

# Option 2 (Server Mode):
# To use an external PostgreSQL server, comment out VERITY_DATA_DIR above and uncomment DATABASE_URL below:
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/VerityAI"

# ==============================================================================
# AI & Security Configuration
# ==============================================================================
# Local AI context window size in tokens (minimum 4096, default 8192)
VERITY_LOCAL_CONTEXT=8192

# Optional 32-byte encryption key secret for API keys stored at rest.
# If unset, an encryption key is automatically generated in $VERITY_DATA_DIR/local.key
# VERITY_KEY_SECRET=""

# ==============================================================================
# Publisher & Application Metadata (About and Legal pages)
# ==============================================================================
NEXT_PUBLIC_PUBLISHER_NAME="Sunrays, Nathaneal, Anxiety, and Maaz"
NEXT_PUBLIC_PUBLISHER_ENTITY="Sunrays, Nathaneal, Anxiety, and Maaz"
NEXT_PUBLIC_PUBLISHER_ADDRESS="Local Developer Environment"
NEXT_PUBLIC_SUPPORT_EMAIL="support@VerityAI.example"
NEXT_PUBLIC_PRIVACY_EMAIL="privacy@VerityAI.example"
NEXT_PUBLIC_PUBLISHER_WEBSITE="https://VerityAI.local"
