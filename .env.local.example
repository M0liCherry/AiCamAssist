# Target A — Windows / self-hosted (fully offline, local models)
# Copy to .env.local. Nothing here leaves your PC.
VERITY_DATA_DIR="./.verity"
VERITY_MIGRATIONS_DIR="./drizzle"

# Local AI context window (tokens)
VERITY_LOCAL_CONTEXT=8192

# Optional: fixed key-encryption secret (otherwise auto-generated in .verity/local.key)
# VERITY_KEY_SECRET=""

# Do NOT set DATABASE_URL, VERCEL, or VERITY_HOSTED for this target.
# Leave them unset and the app uses embedded PGlite + Ollama + KokoClone offline.

NEXT_PUBLIC_PUBLISHER_NAME="Verity AI Project (independent developer build)"
NEXT_PUBLIC_SUPPORT_EMAIL="maazbaig2006@gmail.com"
NEXT_PUBLIC_PRIVACY_EMAIL="maazbaig2006@gmail.com"
