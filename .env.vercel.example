# Target B — Hosted (Vercel, cloud API backends only)
# Set these in the Vercel dashboard → Settings → Environment Variables (Production).

# Required: hosted PostgreSQL (Vercel Postgres, Neon, Supabase). Include
# ?sslmode=require if your provider needs it. Without this the app falls back
# to the embedded database, which cannot persist on serverless filesystems.
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# Required: marks this as the hosted target (Vercel sets VERCEL=1 itself;
# set this explicitly for any other host). Local runtimes (Ollama,
# llama.cpp, KokoClone) are hidden and cloud backends (Gemini/Claude) are used.
VERITY_HOSTED="true"

# Recommended: stable secret for encrypting stored API keys across redeploys.
VERITY_KEY_SECRET=""

# Do NOT set VERITY_DATA_DIR for this target.

NEXT_PUBLIC_PUBLISHER_NAME="Verity AI Project (independent developer build)"
NEXT_PUBLIC_SUPPORT_EMAIL="maazbaig2006@gmail.com"
NEXT_PUBLIC_PRIVACY_EMAIL="maazbaig2006@gmail.com"
